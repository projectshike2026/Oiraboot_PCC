    async function handlePdfUpload(event) {
      const files = Array.from(event.target.files || []);
      if (!files.length) return;

      for (const file of files) {
        try {
          const arrayBuffer = await file.arrayBuffer();
          const pdf = await pdfjsLib.getDocument({ data: arrayBuffer }).promise;
          const pages = [];
          for (let p = 1; p <= pdf.numPages; p++) {
            const page = await pdf.getPage(p);
            const content = await page.getTextContent();
            const text = content.items.map(item => item.str).join(' ').replace(/\s+/g, ' ').trim();
            if (text.length > 0) pages.push({ pageNumber: p, text });
          }
          if (pages.length === 0) {
            showToast('Unreadable PDF Layer', `${file.name} has no selectable text layer.`, true);
            continue;
          }
          pdfDocuments.push({
            id: 'pdf-' + Date.now() + '-' + Math.random().toString(36).slice(2, 6),
            name: file.name,
            pages,
          });
          showToast('Document Indexed', `${file.name} (${pages.length} pages) added to library.`);
        } catch (_) {
          showToast('Upload Error', `Could not parse ${file.name}. Ensure it is a text-based PDF.`, true);
        }
      }
      event.target.value = '';
      renderPdfList();
    }

