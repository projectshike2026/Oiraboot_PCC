    async function handlePdfChatSubmit(e) {
      e.preventDefault();
      const input = document.getElementById('pdf-chat-input');
      const query = input.value.trim();
      if (!query) return;

      input.value = '';
      appendPdfMessage('user', escapeHtml(query));

      const loadingEl = appendPdfMessage('assistant', `
        <div class="flex items-center gap-2.5 text-muted text-xs font-mono">
          <div class="flex items-center gap-1"><span class="pulse-bar"></span><span class="pulse-bar"></span><span class="pulse-bar"></span></div>
          <span>Searching indexed pages & verifying citations...</span>
        </div>
      `);

      const corpusContext = pdfDocuments.map(doc =>
        doc.pages.map(p => `[FILE: ${doc.name} | PAGE: ${p.pageNumber}]\n${p.text}`).join('\n\n')
      ).join('\n\n---\n\n');

      const schema = {
        type: 'OBJECT',
        properties: {
          found: { type: 'BOOLEAN' },
          answer: { type: 'STRING' },
          sourceDoc: { type: 'STRING' },
          pageNumber: { type: 'INTEGER' },
          excerpt: { type: 'STRING' },
        },
        required: ['found', 'answer', 'sourceDoc', 'pageNumber', 'excerpt'],
      };

      let parsed = null;
      const aiText = await callGeminiAPI({
        systemPrompt: `You are a strict Document Assistant. Answer ONLY using the provided PDF pages. Do NOT use external facts. If not present, set found=false and answer="Not found in the document". Match user language (English or Bangla). Return JSON: found, answer, sourceDoc, pageNumber, excerpt.`,
        userPrompt: `DOCUMENTS:\n${corpusContext.slice(0, 18000)}\n\nQUESTION: ${query}`,
        responseSchema: schema,
      });

      if (aiText) {
        try { parsed = JSON.parse(aiText); } catch (_) { parsed = null; }
      }

      if (!parsed) {
        const hit = retrieveBestPdfChunk(query);
        const isBangla = /[\u0980-\u09FF]/.test(query) || currentLang === 'bn';
        if (!hit) {
          parsed = {
            found: false,
            answer: isBangla
              ? 'Not found in the document (এই প্রশ্নের উত্তর আপলোডকৃত ডকুমেন্টে পাওয়া যায়নি)।'
              : 'Not found in the document.',
            sourceDoc: '',
            pageNumber: 0,
            excerpt: '',
          };
        } else {
          let synthAnswer = hit.excerpt;
          if (isBangla && hit.pageNumber === 3 && hit.docName === DEFAULT_SAMPLE_PDF.name) {
            synthAnswer = 'ওভারফিটিং (Overfitting) তখন ঘটে যখন কোনো মেশিন লার্নিং মডেল ট্রেনিং ডেটার নয়েজ মুখস্থ করে ফেলে—ফলে ট্রেনিং এরর কম হলেও অদেখা টেস্ট ডেটায় পারফরম্যান্স খারাপ হয়। এটি কমানোর উপায়: L1/L2 রেগুলারাইজেশন, ড্রপআউট লেয়ার, আর্লি স্টপিং, ক্রস-ভ্যালিডেশন ও ডেটা অগমেন্টেশন।';
          }
          parsed = {
            found: true,
            answer: synthAnswer,
            sourceDoc: hit.docName,
            pageNumber: hit.pageNumber,
            excerpt: hit.excerpt.slice(0, 240) + (hit.excerpt.length > 240 ? '...' : ''),
          };
        }
      }

      loadingEl.remove();

      if (!parsed.found) {
        appendPdfMessage('assistant', `
          <div class="flex items-start gap-2.5">
            <i data-lucide="shield-alert" class="w-4 h-4 text-crimson shrink-0 mt-0.5"></i>
            <div>
              <p class="text-sm font-bold text-main">Not found in the document</p>
              <p class="text-xs text-muted mt-1">Source verification prevented ungrounded speculation. This subject does not appear in your uploaded document archive.</p>
            </div>
          </div>
        `);
      } else {
        appendPdfMessage('assistant', `
          <p class="text-sm text-main leading-relaxed">${escapeHtml(parsed.answer)}</p>
          <div class="p-3.5 rounded-xl bg-[var(--bg-surface)] border border-hairline border-l-[3px] border-l-[var(--crimson)] space-y-1.5">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <span class="font-mono text-[10px] uppercase tracking-wider text-crimson font-bold flex items-center gap-1.5">
                <i data-lucide="quote" class="w-3 h-3"></i> Verified Excerpt
              </span>
              <span class="px-2 py-0.5 rounded bg-crimson-soft text-crimson font-mono text-[10px] font-semibold">
                Page ${parsed.pageNumber} • ${escapeHtml(parsed.sourceDoc)}
              </span>
            </div>
            <p class="text-[11px] text-muted italic leading-relaxed">"${escapeHtml(parsed.excerpt)}"</p>
          </div>
