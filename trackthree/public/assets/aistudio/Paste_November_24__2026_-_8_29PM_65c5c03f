  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            athens: ['Cinzel', 'Hind Siliguri', 'serif'],
            editorial: ['Cormorant Garamond', 'Hind Siliguri', 'serif'],
            sans: ['Plus Jakarta Sans', 'Hind Siliguri', 'sans-serif'],
            mono: ['JetBrains Mono', 'monospace'],
          },
        },
      },
    };
  </script>

  <style>
    /* =========================================================================
       CLASSICAL EDITORIAL DESIGN TOKENS — WHITE, BLACK & CRIMSON RED
       Seamless Light (Marble White) & Dark (Obsidian Black) Architecture
       ========================================================================= */
    :root,
    [data-theme="light"] {
      --bg-page: #FAF9F6;
      --bg-surface: #FFFFFF;
      --bg-subtle: #F2EFE9;
      --bg-elevated: rgba(255, 255, 255, 0.88);
      --bg-inverse: #0B0B0D;
      --text-inverse: #FAF9F6;
      --text-main: #0B0B0D;
      --text-muted: #4A4A52;
      --text-faint: #7A7A85;
      --border-hairline: rgba(11, 11, 13, 0.11);
      --border-strong: rgba(11, 11, 13, 0.24);
      --crimson: #C8102E;
      --crimson-hover: #9E0B23;
      --crimson-soft: rgba(200, 16, 46, 0.07);
      --crimson-border: rgba(200, 16, 46, 0.28);
      --grid-line: rgba(11, 11, 13, 0.045);
      --shadow-card: 0 24px 60px -28px rgba(11, 11, 13, 0.16);
      --shadow-hover: 0 32px 72px -24px rgba(11, 11, 13, 0.22);
      --input-bg: #FAF9F6;
      --select-bg: #FFFFFF;
    }

    [data-theme="dark"] {
      --bg-page: #08080A;
      --bg-surface: #111114;
      --bg-subtle: #18181D;
      --bg-elevated: rgba(17, 17, 20, 0.88);
      --bg-inverse: #FAF9F6;
      --text-inverse: #08080A;
      --text-main: #FAF9F6;
      --text-muted: #A6A6B0;
      --text-faint: #71717A;
      --border-hairline: rgba(250, 249, 246, 0.11);
      --border-strong: rgba(250, 249, 246, 0.24);
      --crimson: #DC2626;
      --crimson-hover: #EF4444;
      --crimson-soft: rgba(220, 38, 38, 0.13);
      --crimson-border: rgba(220, 38, 38, 0.36);
      --grid-line: rgba(250, 249, 246, 0.04);
      --shadow-card: 0 26px 64px -26px rgba(0, 0, 0, 0.8);
      --shadow-hover: 0 34px 76px -22px rgba(0, 0, 0, 0.92);
      --input-bg: #0C0C0F;
      --select-bg: #141418;
    }

    * {
      box-sizing: border-box;
    }

    html, body {
      background-color: var(--bg-page);
      color: var(--text-main);
      font-family: 'Plus Jakarta Sans', 'Hind Siliguri', sans-serif;
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
      transition: background-color 0.45s cubic-bezier(0.22, 1, 0.36, 1), color 0.45s cubic-bezier(0.22, 1, 0.36, 1);
    }

    /* Subtle Classical Architectural Blueprint Grid */
    .architectural-grid {
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 0;
      background-image:
        linear-gradient(to right, var(--grid-line) 1px, transparent 1px),
        linear-gradient(to bottom, var(--grid-line) 1px, transparent 1px);
      background-size: 84px 84px;
      mask-image: radial-gradient(ellipse 85% 75% at 50% 25%, #000 45%, transparent 100%);
      -webkit-mask-image: radial-gradient(ellipse 85% 75% at 50% 25%, #000 45%, transparent 100%);
    }

    /* Fixed Minimalist 3D Architectural Canvas */
    #webgl-canvas {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      z-index: 1;
      pointer-events: none;
    }

    /* Theme-Aware Surface Utilities */
    .surface-card {
      background-color: var(--bg-surface);
      border: 1px solid var(--border-hairline);
      box-shadow: var(--shadow-card);
      transition: background-color 0.4s ease, border-color 0.35s ease, transform 0.45s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.45s ease;
    }

    .surface-elevated {
      background-color: var(--bg-elevated);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      border: 1px solid var(--border-hairline);
    }

    .surface-subtle {
      background-color: var(--bg-subtle);
      border: 1px solid var(--border-hairline);
    }

    .text-main { color: var(--text-main); }
    .text-muted { color: var(--text-muted); }
    .text-faint { color: var(--text-faint); }
    .text-crimson { color: var(--crimson); }
    .bg-crimson { background-color: var(--crimson); }
    .bg-crimson-soft { background-color: var(--crimson-soft); }
    .border-hairline { border-color: var(--border-hairline); }
    .border-crimson { border-color: var(--crimson-border); }

    /* Interactive Editorial Card Hover */
    .editorial-card {
      position: relative;
      overflow: hidden;
    }

    .editorial-card::after {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 2px;
      background: var(--crimson);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .editorial-card:hover {
      border-color: var(--border-strong);
      transform: translateY(-4px);
      box-shadow: var(--shadow-hover);
    }

    .editorial-card:hover::after {
      transform: scaleX(1);
    }

    /* Primary & Secondary Architectural Buttons */
    .btn-primary {
      background-color: var(--bg-inverse);
      color: var(--text-inverse);
      border: 1px solid var(--bg-inverse);
      position: relative;
      overflow: hidden;
      transition: all 0.35s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .btn-primary:hover {
      background-color: var(--crimson);
      border-color: var(--crimson);
      color: #FFFFFF;
      transform: translateY(-1px);
    }

    .btn-crimson {
      background-color: var(--crimson);
      color: #FFFFFF;
      border: 1px solid var(--crimson);
      transition: all 0.35s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .btn-crimson:hover {
      background-color: var(--crimson-hover);
      border-color: var(--crimson-hover);
      transform: translateY(-1px);
    }

    .btn-outline {
      background-color: transparent;
      color: var(--text-main);
      border: 1px solid var(--border-strong);
      transition: all 0.3s ease;
    }

    .btn-outline:hover {
      border-color: var(--crimson);
      color: var(--crimson);
      background-color: var(--crimson-soft);
    }

    /* Form Controls */
    .field-input {
      background-color: var(--input-bg);
      color: var(--text-main);
      border: 1px solid var(--border-hairline);
      transition: border-color 0.25s ease, background-color 0.35s ease;
    }

    .field-input:focus {
      outline: none;
      border-color: var(--crimson);
    }

    .field-input::placeholder {
      color: var(--text-faint);
    }

    select.field-input {
      background-color: var(--select-bg);
    }

    /* Classical Preloader Curtain */
    #preloader {
      position: fixed;
      inset: 0;
      z-index: 100;
      background-color: #08080A;
      color: #FAF9F6;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      transition: opacity 0.8s cubic-bezier(0.76, 0, 0.24, 1), transform 0.8s cubic-bezier(0.76, 0, 0.24, 1);
    }

    #preloader.hidden-curtain {
      opacity: 0;
      transform: translateY(-24px);
      pointer-events: none;
    }

    @keyframes redRuleLoad {
      0% { transform: scaleX(0); transform-origin: left; }
      50% { transform: scaleX(1); transform-origin: left; }
      51% { transform: scaleX(1); transform-origin: right; }
      100% { transform: scaleX(0); transform-origin: right; }
    }

    .preloader-rule {
      animation: redRuleLoad 1.35s cubic-bezier(0.65, 0, 0.35, 1) infinite;
    }

    /* Typewriter Blinking Cursor */
    @keyframes cursorBlink {
      0%, 49% { opacity: 1; }
      50%, 100% { opacity: 0; }
    }

    .type-cursor {
      display: inline-block;
      width: 2.5px;
      height: 1.15em;
      background-color: var(--crimson);
      vertical-align: -0.18em;
      margin-left: 3px;
      animation: cursorBlink 0.9s step-end infinite;
    }

    /* Kinetic Editorial Marquee */
    @keyframes marqueeMove {
      0% { transform: translateX(0); }
      100% { transform: translateX(-50%); }
    }

    .marquee-track {
      display: flex;
      width: max-content;
      animation: marqueeMove 36s linear infinite;
    }

    .marquee-track:hover {
      animation-play-state: paused;
    }

    /* Scroll Reveal Motion */
    .reveal {
      opacity: 0;
      transform: translateY(28px);
      transition: opacity 0.85s cubic-bezier(0.22, 1, 0.36, 1), transform 0.85s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .reveal.visible {
      opacity: 1;
      transform: translateY(0);
    }

    .reveal-delay-1 { transition-delay: 0.1s; }
    .reveal-delay-2 { transition-delay: 0.2s; }

    /* Message & Panel Entrance */
    @keyframes riseIn {
      from { opacity: 0; transform: translateY(12px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .msg-animate {
      animation: riseIn 0.38s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }

    .panel-active {
      animation: riseIn 0.45s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }

    /* Minimalist Animated Pulse Bars */
    @keyframes pulseBar {
      0%, 100% { transform: scaleY(0.35); opacity: 0.4; }
      50% { transform: scaleY(1); opacity: 1; }
    }

    .pulse-bar {
      width: 2.5px;
      height: 13px;
      background-color: var(--crimson);
      border-radius: 99px;
      animation: pulseBar 0.85s ease-in-out infinite;
    }
    .pulse-bar:nth-child(2) { animation-delay: 0.15s; }
    .pulse-bar:nth-child(3) { animation-delay: 0.3s; }

    /* Precision Range Slider */
    input[type="range"].crimson-slider {
      -webkit-appearance: none;
      appearance: none;
      height: 4px;
      border-radius: 999px;
      background: var(--border-strong);
      outline: none;
    }

    input[type="range"].crimson-slider::-webkit-slider-thumb {
      -webkit-appearance: none;
      appearance: none;
      width: 18px;
      height: 18px;
      border-radius: 50%;
      background: var(--crimson);
      border: 3px solid var(--bg-surface);
      box-shadow: 0 0 0 1px var(--crimson);
      cursor: pointer;
      transition: transform 0.2s ease;
    }

    input[type="range"].crimson-slider::-webkit-slider-thumb:hover {
      transform: scale(1.18);
    }

    /* Refined Scrollbars */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: transparent;
    }
    ::-webkit-scrollbar-thumb {
      background: var(--border-strong);
      border-radius: 999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: var(--crimson);
    }

    /* Subtle Column Ornament Line */
    .athens-rule {
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .athens-rule::after {
      content: '';
      height: 1px;
      flex: 1;
      background: var(--border-hairline);
    }
  </style>
</head>
