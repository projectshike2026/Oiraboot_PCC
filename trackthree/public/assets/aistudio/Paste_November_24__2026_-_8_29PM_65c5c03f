        if (twCharIndex <= 0) {
          twDeleting = false;
          twSlideIndex = (twSlideIndex + 1) % slides.length;
          twTimer = setTimeout(runTypewriterTick, 320);
          return;
        }
        twTimer = setTimeout(runTypewriterTick, 16);
      }
