  <script>
    /* =========================================================================
       0. GLOBAL CONFIG & HELPERS
       ========================================================================= */
    const apiKey = ""; // Provided automatically in runtime
    const GEMINI_ENDPOINT = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${apiKey}`;

    if (typeof pdfjsLib !== 'undefined') {
      pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
    }

    let currentLang = 'en';
    let currentTheme = 'light'; // 'light' (White/Black/Red) or 'dark' (Black/White/Red)
    let activeModule = 1;

    function escapeHtml(str) {
      if (str === null || str === undefined) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    function showToast(title, message, isAlert = false) {
      const container = document.getElementById('toast-container');
      const el = document.createElement('div');
      el.className = `pointer-events-auto surface-card rounded-xl p-4 border-l-[3px] ${isAlert ? 'border-l-[var(--crimson)]' : 'border-l-[var(--bg-inverse)]'} msg-animate flex items-start gap-3`;
      el.innerHTML = `
        <i data-lucide="${isAlert ? 'alert-circle' : 'check-circle-2'}" class="w-4 h-4 text-crimson shrink-0 mt-0.5"></i>
        <div class="flex-1 min-w-0">
          <p class="text-xs font-bold text-main">${escapeHtml(title)}</p>
          <p class="text-[11px] text-muted mt-0.5 leading-snug">${escapeHtml(message)}</p>
        </div>
      `;
      container.appendChild(el);
      lucide.createIcons();
      setTimeout(() => {
        el.style.opacity = '0';
        el.style.transform = 'translateY(8px)';
        el.style.transition = 'all 0.3s ease';
        setTimeout(() => el.remove(), 300);
      }, 3400);
    }

    function openCustomModal(title, htmlContent) {
      document.getElementById('modal-title').textContent = title;
      document.getElementById('modal-body').innerHTML = htmlContent;
      const modal = document.getElementById('custom-modal');
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      lucide.createIcons();
    }

    function closeCustomModal() {
      const modal = document.getElementById('custom-modal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    async function callGeminiAPI({ systemPrompt, userPrompt, contentsOverride = null, responseSchema = null }) {
      const payload = {
        contents: contentsOverride || [{ role: 'user', parts: [{ text: userPrompt }] }],
        systemInstruction: systemPrompt ? { parts: [{ text: systemPrompt }] } : undefined,
      };
      if (responseSchema) {
        payload.generationConfig = {
          responseMimeType: 'application/json',
          responseSchema,
        };
      }

      const delays = [1000, 2000, 4000];
      for (let attempt = 0; attempt <= delays.length; attempt++) {
        try {
          const res = await fetch(GEMINI_ENDPOINT, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
          if (!res.ok) {
            if (attempt < delays.length && (res.status === 429 || res.status >= 500)) {
              await new Promise(r => setTimeout(r, delays[attempt]));
              continue;
            }
            return null;
          }
          const data = await res.json();
          return data?.candidates?.[0]?.content?.parts?.[0]?.text || null;
        } catch (_) {
          if (attempt < delays.length) {
            await new Promise(r => setTimeout(r, delays[attempt]));
            continue;
          }
          return null;
        }
      }
      return null;
    }

