      }

      const stopWords = new Set(['what', 'is', 'the', 'and', 'for', 'how', 'does', 'why', 'are', 'in', 'of', 'to', 'a', 'an', 'explain', 'tell', 'me', 'about', 'can', 'you', 'who', 'when', 'where', 'কী', 'এবং', 'কীভাবে', 'কেন', 'এর']);
      const tokens = expanded.replace(/[^\w\s\u0980-\u09FF]/g, ' ').split(/\s+/).filter(w => w.length > 2 && !stopWords.has(w));

      let best = null;
      let bestScore = 0;

      for (const doc of pdfDocuments) {
        for (const page of doc.pages) {
          const textLower = page.text.toLowerCase();
          let score = 0;
          for (const tok of tokens) {
            if (textLower.includes(tok)) score += tok.length > 5 ? 3 : 1.5;
          }
          if (score > bestScore) {
            bestScore = score;
            best = { docName: doc.name, pageNumber: page.pageNumber, excerpt: page.text, score };
          }
        }
      }
      return bestScore >= 2.5 ? best : null;
    }

