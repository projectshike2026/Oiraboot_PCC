    function handleCsvUpload(event) {
      const file = event.target.files?.[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = (e) => {
        try {
          const lines = e.target.result.split(/\r?\n/).filter(l => l.trim().length > 0);
          if (lines.length < 2) throw new Error('Empty CSV');
          const parsed = [];
          for (let i = 1; i < lines.length; i++) {
            const cols = lines[i].split(',').map(c => c.trim());
            if (cols.length < 5) continue;
            parsed.push({
              id: 'csv-' + i,
              name: cols[0] || `Award #${i}`,
              provider: cols[1] || 'Uploaded Provider',
              minCgpa: parseFloat(cols[2]) || 3.0,
              departments: (cols[3] || 'ALL').split('|').map(d => d.trim().toUpperCase()),
              needRequired: ['true', 'yes'].includes(String(cols[4]).toLowerCase()),
              amountBDT: parseInt(cols[5], 10) || 50000,
              deadline: cols[6] || '2027-01-30',
              checklist: ['Prepare Academic Transcript', 'Complete Provider Form', 'Submit Before Deadline'],
            });
          }
          if (parsed.length > 0) {
            scholarshipCatalog = parsed;
            document.getElementById('csv-count-label').textContent = `${parsed.length} Records (CSV)`;
            showToast('CSV Loaded', `Imported ${parsed.length} scholarships from ${file.name}.`);
            runScholarshipMatcher(new Event('submit'));
          }
        } catch (_) {
          showToast('CSV Format Hint', 'Expected: Name, Provider, MinCGPA, Dept(ALL|CSE), Need(true/false), Amount, Deadline.', true);
        }
      };
      reader.readAsText(file);
      event.target.value = '';
    }

    function evaluateScholarships() {
      const cgpa = parseFloat(document.getElementById('student-cgpa').value);
      const dept = document.getElementById('student-dept').value;
      const need = document.getElementById('student-need').checked;

      latestMatched = [];
      latestAlmost = [];

      for (const s of scholarshipCatalog) {
        const deptOk = s.departments.includes('ALL') || s.departments.includes(dept);
        const cgpaOk = cgpa >= s.minCgpa;
        const needOk = !s.needRequired || need;

        if (deptOk && cgpaOk && needOk) {
          latestMatched.push(s);
        } else if (deptOk) {
          const missing = [];
          if (!cgpaOk && (s.minCgpa - cgpa) <= 0.45) {
            missing.push(`Need +${(s.minCgpa - cgpa).toFixed(2)} CGPA (Min ${s.minCgpa.toFixed(2)})`);
          }
          if (!needOk) {
            missing.push('Requires demonstrated financial need');
          }
          if (missing.length > 0 && (cgpaOk || (s.minCgpa - cgpa) <= 0.45)) {
            latestAlmost.push({ ...s, missing });
          }
        }
      }
      return { cgpa, dept, need };
    }

    function buildLocalReason(s, cgpa, dept, need) {
      const margin = (cgpa - s.minCgpa).toFixed(2);
      if (currentLang === 'bn') {
        return `আপনার ${cgpa.toFixed(2)} CGPA এই বৃত্তির ন্যূনতম ${s.minCgpa.toFixed(2)} মানদণ্ডের চেয়ে +${margin} বেশি এবং ${dept} বিভাগের জন্য সরাসরি উপযুক্ত${s.needRequired ? ' (আর্থিক সহায়তা কোটাসহ)' : ''}।`;
      }
      return `Strong profile alignment: your ${cgpa.toFixed(2)} CGPA exceeds the ${s.minCgpa.toFixed(2)} minimum by +${margin}, matches ${dept}${s.needRequired && need ? ', and supports your financial aid criteria' : ''}.`;
    }

    async function runScholarshipMatcher(e) {
      if (e) e.preventDefault();
      const { cgpa, dept, need } = evaluateScholarships();
      const btn = document.getElementById('find-scholarships-btn');
      if (btn) {
        btn.disabled = true;
        btn.innerHTML = `<i data-lucide="loader-2" class="w-4 h-4 animate-spin"></i><span>Evaluating Eligibility...</span>`;
        lucide.createIcons();
      }

      latestMatched.forEach(s => {
        matchReasons[s.id] = buildLocalReason(s, cgpa, dept, need);
      });
      renderScholarshipResults();

      if (latestMatched.length > 0) {
        const schema = {
          type: 'ARRAY',
          items: {
            type: 'OBJECT',
            properties: { id: { type: 'STRING' }, reason: { type: 'STRING' } },
            required: ['id', 'reason'],
          },
        };
        const aiText = await callGeminiAPI({
          systemPrompt: `You are a university scholarship advisor. For each matched scholarship, write a concise 1-sentence reason why it fits the student. Language: ${currentLang === 'bn' ? 'Bangla' : 'English'}. Zero emojis.`,
          userPrompt: `Student: CGPA=${cgpa}, Dept=${dept}, Financial Need=${need}.\nMatched: ${JSON.stringify(latestMatched.map(s => ({ id: s.id, name: s.name, minCgpa: s.minCgpa, needRequired: s.needRequired, amountBDT: s.amountBDT })))}`,
          responseSchema: schema,
        });
        if (aiText) {
          try {
            JSON.parse(aiText).forEach(item => {
              if (item.id && item.reason) matchReasons[item.id] = item.reason;
            });
            renderScholarshipResults();
          } catch (_) { /* retain deterministic reasons */ }
        }
      }

      if (btn) {
        btn.disabled = false;
        btn.innerHTML = `<i data-lucide="search-check" class="w-4 h-4"></i><span>Evaluate & Match Awards</span>`;
        lucide.createIcons();
      }
    }

    function renderScholarshipResults() {
      const container = document.getElementById('scholarship-results-container');
      const almostSec = document.getElementById('almost-qualified-section');
      const almostList = document.getElementById('almost-qualified-list');

      const sorted = [...latestMatched].sort((a, b) =>
        scholarshipSort === 'amount' ? b.amountBDT - a.amountBDT : new Date(a.deadline) - new Date(b.deadline)
      );

      document.getElementById('matched-count-pill').textContent = `${sorted.length} Eligible`;
      document.getElementById('almost-count-pill').textContent = `${latestAlmost.length} Near Match`;

      if (sorted.length === 0) {
        container.innerHTML = `
          <div class="surface-card rounded-2xl p-10 text-center space-y-3">
            <div class="w-12 h-12 mx-auto rounded-xl surface-subtle flex items-center justify-center text-crimson">
              <i data-lucide="search-x" class="w-6 h-6"></i>
            </div>
            <h4 class="font-athens text-lg font-bold text-main">No Direct Matches Found</h4>
            <p class="text-xs text-muted max-w-md mx-auto">Adjust your CGPA, department, or financial support setting — or review the Near-Match Gap panel below.</p>
          </div>
        `;
      } else if (scholarshipView === 'table') {
        container.innerHTML = `
          <div class="surface-card rounded-2xl overflow-hidden">
            <div class="overflow-x-auto">
              <table class="w-full text-left border-collapse">
                <thead>
                  <tr class="border-b border-hairline bg-[var(--bg-subtle)] font-mono text-[10px] uppercase tracking-widest text-faint">
                    <th class="py-4 px-5">Scholarship</th>
                    <th class="py-4 px-4">Award (BDT)</th>
                    <th class="py-4 px-4">Min CGPA</th>
                    <th class="py-4 px-4">Deadline</th>
                    <th class="py-4 px-5">Match Rationale</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-[var(--border-hairline)] text-xs">
                  ${sorted.map(s => `
                    <tr class="hover:bg-[var(--bg-subtle)] transition-colors">
                      <td class="py-4 px-5">
                        <p class="font-bold text-main">${escapeHtml(s.name)}</p>
                        <p class="text-[11px] text-muted">${escapeHtml(s.provider)}</p>
                      </td>
                      <td class="py-4 px-4 font-mono font-bold text-crimson">BDT ${s.amountBDT.toLocaleString()}</td>
                      <td class="py-4 px-4 font-mono text-main">${s.minCgpa.toFixed(2)}</td>
                      <td class="py-4 px-4 font-mono text-muted">${escapeHtml(s.deadline)}</td>
                      <td class="py-4 px-5 text-muted max-w-xs leading-relaxed">${escapeHtml(matchReasons[s.id] || '')}</td>
                    </tr>
                  `).join('')}
                </tbody>
              </table>
            </div>
          </div>
        `;
      } else {
        container.innerHTML = sorted.map(s => `
          <div class="surface-card editorial-card rounded-2xl p-6 space-y-4 msg-animate">
            <div class="flex flex-wrap items-start justify-between gap-4">
              <div class="space-y-1">
                <div class="flex flex-wrap items-center gap-2">
                  <span class="px-2.5 py-0.5 rounded bg-[var(--bg-inverse)] text-[var(--text-inverse)] font-mono text-[10px] font-bold uppercase">Eligible</span>
                  ${s.needRequired ? `<span class="px-2.5 py-0.5 rounded bg-crimson-soft border border-crimson font-mono text-[10px] font-semibold text-crimson uppercase">Need-Based</span>` : ''}
                  <span class="font-mono text-[10px] text-faint">Min CGPA ${s.minCgpa.toFixed(2)}</span>
                </div>
                <h4 class="font-athens text-base sm:text-lg font-bold text-main">${escapeHtml(s.name)}</h4>
                <p class="text-xs text-muted">${escapeHtml(s.provider)}</p>
              </div>
              <div class="text-right">
                <p class="font-mono text-lg font-bold text-crimson">BDT ${s.amountBDT.toLocaleString()}</p>
                <p class="font-mono text-[11px] text-muted flex items-center justify-end gap-1 mt-0.5">
                  <i data-lucide="calendar" class="w-3 h-3 text-crimson"></i> Due ${escapeHtml(s.deadline)}
                </p>
              </div>
            </div>

            <div class="p-3.5 rounded-xl surface-subtle border-l-[3px] border-l-[var(--crimson)] flex items-start gap-2.5">
              <i data-lucide="check-circle-2" class="w-4 h-4 text-crimson shrink-0 mt-0.5"></i>
              <p class="text-xs text-main leading-relaxed">
                <strong>Fit Summary:</strong> ${escapeHtml(matchReasons[s.id] || '')}
              </p>
            </div>

            <details class="group">
              <summary class="cursor-pointer list-none flex items-center justify-between text-xs font-bold text-muted hover:text-crimson transition-colors pt-1">
                <span class="flex items-center gap-2">
                  <i data-lucide="list-checks" class="w-4 h-4 text-crimson"></i>
                  <span>Application Checklist (${s.checklist.length} Steps)</span>
                </span>
                <i data-lucide="chevron-down" class="w-4 h-4 group-open:rotate-180 transition-transform"></i>
              </summary>
              <ul class="mt-3 pt-3 border-t border-hairline space-y-2 text-xs text-muted">
                ${s.checklist.map((step, i) => `
                  <li class="flex items-start gap-2.5">
                    <span class="w-5 h-5 rounded bg-crimson-soft font-mono text-[10px] font-bold text-crimson flex items-center justify-center shrink-0">${i + 1}</span>
                    <span class="text-main">${escapeHtml(step)}</span>
                  </li>
                `).join('')}
              </ul>
            </details>
          </div>
        `).join('');
      }

      if (latestAlmost.length > 0) {
        almostSec.classList.remove('hidden');
        almostList.innerHTML = latestAlmost.map(s => `
          <div class="p-4 rounded-xl surface-subtle space-y-2">
            <div class="flex items-start justify-between gap-2">
              <p class="text-xs font-bold text-main">${escapeHtml(s.name)}</p>
              <span class="font-mono text-[11px] font-bold text-crimson shrink-0">BDT ${s.amountBDT.toLocaleString()}</span>
            </div>
            <div class="flex flex-wrap gap-1.5">
              ${s.missing.map(m => `
                <span class="px-2 py-1 rounded bg-crimson-soft border border-crimson font-mono text-[10px] font-semibold text-crimson flex items-center gap-1">
                  <i data-lucide="arrow-up-circle" class="w-3 h-3"></i> ${escapeHtml(m)}
                </span>
              `).join('')}
            </div>
          </div>
        `).join('');
      } else {
        almostSec.classList.add('hidden');
      }

      lucide.createIcons();
    }

    function downloadScholarshipReport() {
      if (latestMatched.length === 0) {
        showToast('No Matches to Export', 'Run the eligibility matcher first.', true);
        return;
      }
      let csv = 'Scholarship Name,Provider,Amount (BDT),Min CGPA,Deadline,Fit Rationale\n';
      latestMatched.forEach(s => {
        const reason = (matchReasons[s.id] || '').replace(/"/g, '""');
        csv += `"${s.name}","${s.provider}",${s.amountBDT},${s.minCgpa},"${s.deadline}","${reason}"\n`;
      });
      triggerTextDownload(csv, 'PCIU_Matched_Scholarships.csv', 'text/csv');
      showToast('CSV Exported', 'Saved PCIU_Matched_Scholarships.csv');
    }

    function triggerTextDownload(content, filename, mime) {
      const blob = new Blob([content], { type: mime });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      a.remove();
      URL.revokeObjectURL(url);
    }

    /* =========================================================================
       9. MICRO-INTERACTIONS, SCROLL REVEALS & BOOTSTRAP
       ========================================================================= */
    function initMicroInteractions() {
      window.addEventListener('mousemove', (e) => {
        mouseX = (e.clientX / window.innerWidth) * 2 - 1;
        mouseY = -(e.clientY / window.innerHeight) * 2 + 1;
      });

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) entry.target.classList.add('visible');
        });
      }, { threshold: 0.12 });

      document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

      document.getElementById('custom-modal').addEventListener('click', (e) => {
        if (e.target.id === 'custom-modal') closeCustomModal();
      });
      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeCustomModal();
      });
    }

    window.onload = function () {
      try {
        lucide.createIcons();
        initThreeScene();
        animateThree();
        initMicroInteractions();
        restartTypewriter();

        // Hydrate all 3 product modules
        renderPdfList();
        renderAdmissionChecklist();
        initAdmissionChat();
        runScholarshipMatcher();
      } catch (_) {
        // Keep UI fully interactive even if WebGL is disabled
      } finally {
        setTimeout(() => {
          const preloader = document.getElementById('preloader');
          if (preloader) preloader.classList.add('hidden-curtain');
        }, 650);
      }
    };
  </script>
