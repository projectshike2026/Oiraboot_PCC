      updateTypewriterIndicators(twSlideIndex);

      if (!twDeleting) {
        twCharIndex++;
        out.textContent = currentText.slice(0, twCharIndex);
        if (twCharIndex >= currentText.length) {
          twDeleting = true;
          twTimer = setTimeout(runTypewriterTick, 2400);
          return;
        }
        twTimer = setTimeout(runTypewriterTick, 32);
      } else {
        twCharIndex--;
